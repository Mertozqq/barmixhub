PORT=4242
CLIENT_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4242

MERCHANT_NAME=BarMixHub
SUPPORT_EMAIL=barmixhub@mail.ru
SUPPORT_PHONE=+7 (917) 252-02-65

TBANK_API_URL=https://securepay.tinkoff.ru/v2
TBANK_TERMINAL_KEY=
TBANK_SECRET_KEY=
TBANK_TERMINAL_PASSWORD=
TBANK_NOTIFICATION_URL=http://localhost:4242/api/payments/webhook
TBANK_SUCCESS_URL=http://localhost:5173/payment/success
TBANK_FAIL_URL=http://localhost:5173/payment/fail
TBANK_SEND_RECEIPT=false
TBANK_TAXATION=usn_income
TBANK_VAT=none
TBANK_PAYMENT_METHOD=full_prepayment
TBANK_PAYMENT_OBJECT=service

# Яндекс Сплит (Yandex Pay Merchant API)
# Для песочницы: YANDEX_PAY_API_URL=https://sandbox.pay.yandex.ru
YANDEX_PAY_API_URL=https://pay.yandex.ru
YANDEX_PAY_API_KEY=
YANDEX_PAY_MERCHANT_ID=
# Какие методы показывать на платежной странице Яндекс Пэй: SPLIT или CARD,SPLIT
YANDEX_PAY_PAYMENT_METHODS=SPLIT
YANDEX_PAY_TTL_SECONDS=1800
YANDEX_PAY_SUCCESS_URL=http://localhost:5173/payment/success
YANDEX_PAY_FAIL_URL=http://localhost:5173/payment/fail
# Webhook URL для консоли Яндекс Пэй: {PUBLIC_BASE_URL}/api/payments/yandex/webhook

# Рассрочка Inpocket (без API: кнопка-ссылка, заявка сохраняется на бэкенде)
INPOCKET_ENABLED=true
INPOCKET_URL=https://cabinet.inpocket.ru/auth/login

TELEGRAM_RELAY_ENABLED=false
TELEGRAM_RELAY_URL=https://your-worker.your-account.workers.dev/notify
TELEGRAM_RELAY_TOKEN=
TELEGRAM_RELAY_TIMEOUT_MS=5000
